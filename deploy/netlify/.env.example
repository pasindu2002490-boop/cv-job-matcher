# These values are compiled into the browser bundle and are not secrets.
# Set them in Netlify Site configuration > Environment variables.
VITE_API_BASE_URL=https://cvjm-api-your-hash.asia-south1.run.app
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-supabase-publishable-key

# Legacy Supabase projects may use VITE_SUPABASE_ANON_KEY instead. The
# frontend accepts it as a fallback, but do not configure both.
# VITE_SUPABASE_ANON_KEY=your-public-supabase-anon-key

# Production must require a valid Supabase session.
VITE_ALLOW_ANONYMOUS=false

# Optional browser-only tuning.
VITE_POLL_INTERVAL_MS=2500
VITE_MAX_CV_BYTES=10485760

# Never expose SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, GROQ_API_KEY, or
# RESEND_API_KEY through a VITE_* variable.
