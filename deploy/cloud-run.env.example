# This file documents non-secret production settings. The deployment script
# applies these values as Cloud Run environment variables.
#
# Never place DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, GROQ_API_KEY, or
# RESEND_API_KEY in this file. Those values belong in Google Secret Manager.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
CLOUD_RUN_REGION=asia-south1
MATCHER_JOB_NAME=cvjm-matcher

SUPABASE_URL=https://your-project-ref.supabase.co
CV_BUCKET=cv-uploads
RESULT_BUCKET=job-results
CV_RETENTION_HOURS=24
RESULT_RETENTION_HOURS=168

REQUIRE_AUTH=1
ALLOWED_ORIGINS=https://your-site.netlify.app
MAX_CV_UPLOAD_MB=10

TASK_LEASE_SECONDS=900
SOURCE_LEASE_SECONDS=2700
TASK_MAX_ATTEMPTS=3
TASK_RETRY_DELAY_SECONDS=30

SOURCE_AGENT_WORKERS=8
SOURCE_RESULT_LIMIT=5000
CRAWL4AI_ENABLED=1

EMAIL_PROVIDER=resend
EMAIL_FROM=Jobs <jobs@your-verified-domain.example>

OLLAMA_FALLBACK_ENABLED=0
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
LLM_LIMIT=500
LLM_BATCH_SIZE=5
