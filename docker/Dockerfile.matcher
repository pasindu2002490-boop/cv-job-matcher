FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/app \
    TMPDIR=/tmp/cv-job-matcher \
    UPLOAD_ROOT=/tmp/cv-job-matcher/uploads \
    OUTPUT_ROOT=/tmp/cv-job-matcher/results \
    OLLAMA_FALLBACK_ENABLED=0

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --upgrade pip \
    && python -m pip install . \
    && addgroup --system app \
    && adduser --system --ingroup app --home /home/app app \
    && mkdir -p /tmp/cv-job-matcher/uploads /tmp/cv-job-matcher/results \
    && chown -R app:app /home/app /tmp/cv-job-matcher

USER app

CMD ["python", "-m", "cv_job_matcher.cloud_worker", "match"]
