FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/app \
    TMPDIR=/tmp/cv-job-matcher \
    UPLOAD_ROOT=/tmp/cv-job-matcher/uploads \
    OUTPUT_ROOT=/tmp/cv-job-matcher/results

WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --upgrade pip \
    && python -m pip install . \
    && addgroup --system app \
    && adduser --system --ingroup app --home /home/app app \
    && mkdir -p /tmp/cv-job-matcher/uploads /tmp/cv-job-matcher/results \
    && chown -R app:app /home/app /tmp/cv-job-matcher

USER app

EXPOSE 8080

CMD ["sh", "-c", "exec gunicorn --workers ${API_GUNICORN_WORKERS:-1} --threads ${API_GUNICORN_THREADS:-4} --timeout ${API_REQUEST_TIMEOUT_SECONDS:-120} --bind 0.0.0.0:${PORT:-8080} cv_job_matcher.cloud_api:app"]
