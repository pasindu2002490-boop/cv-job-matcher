# Public browser configuration only. Never place a Supabase service-role key here.
VITE_API_BASE_URL=http://localhost:8080
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Keep false in Netlify. Enable only when running an explicitly unauthenticated
# local API during development.
VITE_ALLOW_ANONYMOUS=false

# Optional UI tuning.
VITE_POLL_INTERVAL_MS=2500
VITE_MAX_CV_BYTES=10485760
